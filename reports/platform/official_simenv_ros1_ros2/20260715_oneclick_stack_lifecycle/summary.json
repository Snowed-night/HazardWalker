{
  "owner": "姜晨",
  "date": "2026-07-15",
  "scope": "official SimEnv one-click ROS1 ROS2 business stack lifecycle",
  "container": "simenv_run",
  "ros_domain_id": 42,
  "run_command": "bash scripts/run_official_simenv_ros1_ros2_stack.sh start_navigation:=true",
