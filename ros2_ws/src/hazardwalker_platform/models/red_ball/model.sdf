<?xml version="1.0" ?>
<!--
  HazardWalker Phase 1 — 红色球体危险源模型。

  用途：
    - 在 Gazebo 场景中放置一个静态红色球体，模拟危险源目标。
    - 感知组通过相机图像检测此球体，验证 HSV / YOLO 检测链路。

  运行要求：
    - 需要 Gazebo Harmonic 环境（Linux / Ubuntu 24.04）。
    - 本文件本身是纯 XML，在 Windows 上可做语法校验（见测试脚本）。
-->
<sdf version="1.11">
  <model name="red_ball">
    <!-- 静态模型，不会移动 -->
    <static>true</static>

    <link name="ball_link">

      <!-- 视觉：纯红色球体，半径 0.15m -->
      <visual name="ball_visual">
        <geometry>
          <sphere><radius>0.15</radius></sphere>
        </geometry>
        <material>
          <ambient>0.9 0.08 0.08</ambient>
          <diffuse>0.9 0.08 0.08</diffuse>
          <specular>0.1 0.1 0.1</specular>
          <emissive>0.0 0.0 0.0</emissive>
        </material>
      </visual>

      <!-- 碰撞：与视觉一致，用于 LiDAR 点云生成 -->
      <collision name="ball_collision">
        <geometry>
          <sphere><radius>0.15</radius></sphere>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
