<?xml version="1.0" ?>
<!--
  HazardWalker — 红球检测截图测试场景。

  用途：
    - 在同一个 Gazebo world 中放置多个固定相机和多个红球。
    - 每个相机对应一个测试视角：完整红球、左边缘截断、顶部截断、多个红球。
    - 仅用于感知效果截图与离线验证，不作为正式导航场景。
-->
<sdf version="1.11">
  <world name="hazardwalker_red_ball_gallery">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.55</ambient>
      <background>0.72 0.72 0.72</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="gallery_key_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.9 0.9 0.9</diffuse>
      <specular>0.2 0.2 0.2</specular>
      <direction>-0.5 -0.2 -0.8</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.42 0.42 0.42</ambient>
            <diffuse>0.55 0.55 0.55</diffuse>
            <specular>0.05 0.05 0.05</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 低矮背景墙给截图一点空间参照，避免纯灰地面看起来像空画面。 -->
    <model name="back_wall">
      <static>true</static>
      <pose>3.2 0 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.12 8.0 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.66 0.66 0.66</ambient>
            <diffuse>0.74 0.74 0.74</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.12 8.0 2.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!--
        多个红球：同一模型多次 include，Gazebo 会生成独立实例。
        四组测试沿 y 轴分开，避免不同测试实例互相进入视野。
    -->
    <include>
      <name>red_ball_center_full</name>
      <uri>model://red_ball</uri>
      <pose>2.0 0.00 0.55 0 0 0</pose>
    </include>
    <include>
      <name>red_ball_left_partial</name>
      <uri>model://red_ball</uri>
      <pose>2.0 3.18 0.55 0 0 0</pose>
    </include>
    <include>
      <name>red_ball_top_partial</name>
      <uri>model://red_ball</uri>
      <pose>2.0 -3.20 1.22 0 0 0</pose>
    </include>
    <include>
      <name>red_ball_multi_a</name>
      <uri>model://red_ball</uri>
      <pose>2.1 6.70 0.58 0 0 0</pose>
    </include>
    <include>
      <name>red_ball_multi_b</name>
      <uri>model://red_ball</uri>
      <pose>2.35 7.36 0.74 0 0 0</pose>
    </include>

    <!-- 相机模型：默认相机光轴朝 +X，位置和视场为截图测试定制。 -->
    <model name="camera_center_full">
      <static>true</static>
      <pose>0 0.00 0.55 0 0 0</pose>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.05</near><far>20.0</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10.0</update_rate>
          <visualize>false</visualize>
          <topic>/gallery/center_full/image</topic>
        </sensor>
      </link>
    </model>

    <model name="camera_left_partial">
      <static>true</static>
      <pose>0 4.00 0.55 0 0 0</pose>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>0.75</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.05</near><far>20.0</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10.0</update_rate>
          <visualize>false</visualize>
          <topic>/gallery/left_partial/image</topic>
        </sensor>
      </link>
    </model>

    <model name="camera_top_partial">
      <static>true</static>
      <pose>0 -3.20 0.55 0 0 0</pose>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>0.82</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.05</near><far>20.0</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10.0</update_rate>
          <visualize>false</visualize>
          <topic>/gallery/top_partial/image</topic>
        </sensor>
      </link>
    </model>

    <model name="camera_multi_visible">
      <static>true</static>
      <pose>0 7.00 0.62 0 0 0</pose>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.22</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.05</near><far>20.0</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10.0</update_rate>
          <visualize>false</visualize>
          <topic>/gallery/multi_visible/image</topic>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
