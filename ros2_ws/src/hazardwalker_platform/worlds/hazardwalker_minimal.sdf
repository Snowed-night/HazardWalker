<?xml version="1.0" ?>
<!--
  HazardWalker Phase 1 — 最小楼栋仿真场景。

  场景规格：
    - 单房间：10m × 10m × 3m（四面墙 + 地板）
    - 光照：方向光（模拟室内日光灯）+ 环境光
    - 起点：原点 (0, 0)，机器人面朝 +X
    - 红球位置：(2.0, 0.0, 0.6)

  运行：
      gz sim worlds/hazardwalker_minimal.sdf -r

  Windows 说明：
    - 本文件是纯 XML，可在 Windows 上做语法校验。
    - 实际运行需要 Ubuntu + Gazebo Harmonic。
-->
<sdf version="1.11">
  <world name="hazardwalker_world">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ================================================================
        物理引擎配置
        ================================================================ -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ================================================================
        图形场景：光照 + 背景
        ================================================================ -->
    <scene>
      <ambient>0.4 0.4 0.4</ambient>
      <background>0.7 0.7 0.7</background>
      <grid>true</grid>
    </scene>

    <!-- 方向光：模拟天花板日光灯 -->
    <light type="directional" name="ceiling_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8</diffuse>
      <specular>0.2 0.2 0.2</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 -0.2 -0.9</direction>
    </light>

    <!-- ================================================================
        地板 — 20m × 20m，覆盖整个房间
        ================================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4</ambient>
            <diffuse>0.5 0.5 0.5</diffuse>
            <specular>0.05 0.05 0.05</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
        四面墙 — 围成 10m × 10m × 3m 的封闭房间
        材质：浅灰色，与真实楼栋内墙接近
        ================================================================ -->

    <!-- 北墙 (y = +5) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>10.4 0.2 3.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7</ambient>
            <diffuse>0.75 0.75 0.75</diffuse>
            <specular>0.05 0.05 0.05</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>10.4 0.2 3.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 南墙 (y = -5) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>10.4 0.2 3.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7</ambient>
            <diffuse>0.75 0.75 0.75</diffuse>
            <specular>0.05 0.05 0.05</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>10.4 0.2 3.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 东墙 (x = +5) -->
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.2 10.4 3.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7</ambient>
            <diffuse>0.75 0.75 0.75</diffuse>
            <specular>0.05 0.05 0.05</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.2 10.4 3.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 西墙 (x = -5) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.2 10.4 3.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7</ambient>
            <diffuse>0.75 0.75 0.75</diffuse>
            <specular>0.05 0.05 0.05</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.2 10.4 3.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ================================================================
        模型引用 — 机器人 + 红球

        路径说明：
          模型文件位于本仓库 models/ 目录下。启动时必须将
          models/ 加入 GZ_SIM_RESOURCE_PATH，否则 Gazebo 找不到。
          启动脚本 gazebo_minimal.launch.py 会自动处理。
        ================================================================ -->
    <include>
      <uri>model://simple_robot</uri>
      <pose>0 0 0.15 0 0 0</pose>
    </include>

    <include>
      <uri>model://red_ball</uri>
      <pose>2.0 0.0 0.6 0 0 0</pose>
    </include>

  </world>
</sdf>
