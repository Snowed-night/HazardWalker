# 官方 SimEnv 的独立可视化 sidecar：不启动 Gazebo，只连接已运行的 Classic Master。
# 通过 Xvfb + x11vnc + noVNC 避开 RDP/XWayland 对 Gazebo Qt/OpenGL 的兼容性问题。
FROM simenv_ros1:noetic-focal

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
      x11vnc \
      novnc \
      websockify \
      x11-apps \
      x11-xserver-utils \
      openbox \
      wmctrl \
    && rm -rf /var/lib/apt/lists/*

COPY gui_entrypoint.sh /usr/local/bin/hazardwalker_gui_entrypoint.sh
COPY gui_fullscreen.html /usr/share/novnc/hazardwalker.html
# 入口由 gui_client.sh 的 ``docker run --entrypoint bash`` 显式指定。这样不新增最终
# Docker 配置层，兼容共享主机上会卡在镜像收尾阶段的旧构建器。
