<?xml version="1.0"?>
<!-- 受控多目标正例：三个相互分离的红球。 -->
<sdf version="1.9"><model name="hw_suite_multi_separated"><static>true</static><link name="ball_left_link"><pose>-0.45 0 0.30 0 0 0</pose><visual name="visual"><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link><link name="ball_center_link"><pose>0 0 0.30 0 0 0</pose><visual name="visual"><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link><link name="ball_right_link"><pose>0.45 0 0.30 0 0 0</pose><visual name="visual"><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link></model></sdf>
