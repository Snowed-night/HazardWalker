diff --git a/auto.sh b/auto.sh
index 0300a29..26dee58 100644
--- a/auto.sh
+++ b/auto.sh
@@ -12,6 +12,15 @@ BUILDING_LENGTH="${BUILDING_LENGTH:-36.0}"
 DANGER_COUNT="${DANGER_COUNT:-3:6}"
 DISTRACTOR_COUNT="${DISTRACTOR_COUNT:-4:8}"
 GUI="${GUI:-true}"
+# 无 GUI 的 Docker 仍需要 Gazebo Classic 的渲染后端，RGB/深度传感器才能发布 ROS 图像。
+# HEADLESS 可显式覆盖；未设置时根据 GUI 自动选择，避免 GUI 本地启动行为变化。
+HEADLESS="${HEADLESS:-}"
+if [ -z "$HEADLESS" ]; then
+  case "$GUI" in
+    false|FALSE|False|0) HEADLESS=true ;;
+    *) HEADLESS=false ;;
+  esac
+fi
 PAUSED="${PAUSED:-true}"
 START_CONTROLLER="${START_CONTROLLER:-1}"
 START_VIRTUAL_JOY="${START_VIRTUAL_JOY:-0}"
@@ -89,6 +98,7 @@ roslaunch unitree_guide multi_floor_gazeboSim.launch \
   gui:="$GUI" \
   paused:="$PAUSED" \
   user_debug:=False \
+  headless:="$HEADLESS" \
   rname:=a1 \
   robot_x:="$ROBOT_X" \
   robot_y:="$ROBOT_Y" \
diff --git a/auto_docker.sh b/auto_docker.sh
index 41b876a..27520cc 100755
--- a/auto_docker.sh
+++ b/auto_docker.sh
@@ -11,6 +11,14 @@ BUILDING_LENGTH="${BUILDING_LENGTH:-36.0}"
 DANGER_COUNT="${DANGER_COUNT:-3:6}"
 DISTRACTOR_COUNT="${DISTRACTOR_COUNT:-4:8}"
 GUI="${GUI:-true}"
+# Docker 的 GUI=false 不等于关闭传感器渲染；深度相机需要 Classic headless rendering。
+HEADLESS="${HEADLESS:-}"
+if [ -z "$HEADLESS" ]; then
+  case "$GUI" in
+    false|FALSE|False|0) HEADLESS=true ;;
+    *) HEADLESS=false ;;
+  esac
+fi
 PAUSED="${PAUSED:-true}"
 START_CONTROLLER="${START_CONTROLLER:-1}"
 CONTROLLER_FOREGROUND="${CONTROLLER_FOREGROUND:-1}"
@@ -84,6 +92,7 @@ roslaunch unitree_guide multi_floor_gazeboSim.launch \
   gui:="$GUI" \
   paused:="$PAUSED" \
   user_debug:=False \
+  headless:="$HEADLESS" \
   rname:=a1 \
   robot_x:="$ROBOT_X" \
   robot_y:="$ROBOT_Y" \
diff --git a/start_headless.sh b/start_headless.sh
