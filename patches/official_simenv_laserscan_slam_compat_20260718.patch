@@ -147,6 +147,15 @@
         <child link="laser_livox"/>
     </joint>

+    <!-- Gazebo ray 经 -45° 补偿后实际是水平扫描；用独立水平帧表达这一
+         几何关系，避免 LaserScan 数据挂在上仰的 laser_livox 帧上污染 SLAM。 -->
+    <link name="laser_scan"/>
+    <joint name="laser_scan_joint" type="fixed">
+        <origin xyz="0.2 0 0.08" rpy="0 0 0"/>
+        <parent link="base"/>
+        <child link="laser_scan"/>
+    </joint>
+
     <!-- livox mid360-imu -->
     <!-- 对于本体 -->
     <link name="livox_imu_link">
