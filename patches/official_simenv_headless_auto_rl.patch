 void FSM::initialize(){
-    _currentState = _stateList.passive;
+    // headless 控制器的 stdin 是 /dev/null，不能依赖另一终端输入“2/6”。
+    // 仅在显式设置 SIMENV_AUTO_RL=1 时直接进入已有 RL 状态，默认保留人工键盘流程。
+    const char *autoRl = std::getenv("SIMENV_AUTO_RL");
