diff --git a/scripts/rosbridge_odom_relay.py b/scripts/rosbridge_odom_relay.py
new file mode 100644
index 0000000..588a8a3
--- /dev/null
+++ b/scripts/rosbridge_odom_relay.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""将高频 Gazebo 里程计压缩为只含最新值的 ROS1 中继话题。
+
+负责人：姜晨。供官方 SimEnv headless 启动链路调用，避免 rosbridge 对
+/Odometry_gazebo 的历史消息排队，确保 ROS2 导航获得接近当前仿真时间的位姿。
+"""
+
+import argparse
+import threading
+
+import rospy
+from nav_msgs.msg import Odometry
+
+
+class LatestOdometryRelay:
+    """订阅端队列为 1，定时发布当前最后一条而不转发历史积压。"""
+
+    def __init__(self, source_topic: str, output_topic: str, rate_hz: float):
+        self._latest = None
+        self._lock = threading.Lock()
+        self._publisher = rospy.Publisher(output_topic, Odometry, queue_size=1)
+        self._subscriber = rospy.Subscriber(source_topic, Odometry, self._on_odom, queue_size=1)
+        self._timer = rospy.Timer(rospy.Duration(1.0 / rate_hz), self._publish_latest)
+
+    def _on_odom(self, message: Odometry):
+        with self._lock:
+            self._latest = message
+
+    def _publish_latest(self, _event):
+        with self._lock:
+            latest = self._latest
+        if latest is not None:
+            self._publisher.publish(latest)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--source', default='/Odometry_gazebo')
+    parser.add_argument('--output', default='/hazardwalker/odom')
+    parser.add_argument('--rate-hz', type=float, default=20.0)
+    args = parser.parse_args()
+    if args.rate_hz <= 0:
+        raise SystemExit('--rate-hz 必须大于 0')
+    rospy.init_node('hazardwalker_rosbridge_odom_relay')
+    LatestOdometryRelay(args.source, args.output, args.rate_hz)
+    rospy.loginfo('最新值里程计中继：%s -> %s（%.1f Hz）', args.source, args.output, args.rate_hz)
+    rospy.spin()
+
+
+if __name__ == '__main__':
+    main()
