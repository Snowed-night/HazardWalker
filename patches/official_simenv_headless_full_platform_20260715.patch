diff --git a/auto_headless.sh b/auto_headless.sh
new file mode 100644
index 0000000..0771db1
--- /dev/null
+++ b/auto_headless.sh
@@ -0,0 +1,44 @@
+#!/usr/bin/env bash
+# 官方 SimEnv 可复现 headless 入口。
+# 负责人：姜晨。必须在 Gazebo/gzserver 创建渲染传感器前启动 Xvfb，禁止依赖 expect 或键盘 2→6。
+set -euo pipefail
+
+WORKSPACE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+DISPLAY_VALUE="${SIMENV_HEADLESS_DISPLAY:-:99}"
+XVFB_SCREEN="${SIMENV_XVFB_SCREEN:-1280x1024x24}"
+mkdir -p "$WORKSPACE_DIR/logs"
+
+if ! command -v Xvfb >/dev/null 2>&1; then
+  echo 'Xvfb is not installed. Rebuild simenv:run from docker/Dockerfile.run.' >&2
+  exit 1
+fi
+if ! pgrep -f "Xvfb ${DISPLAY_VALUE}" >/dev/null 2>&1; then
+  echo "Starting Xvfb on ${DISPLAY_VALUE} before Gazebo..."
+  Xvfb "$DISPLAY_VALUE" -screen 0 "$XVFB_SCREEN" +extension GLX +render \
+    > "$WORKSPACE_DIR/logs/xvfb.log" 2>&1 &
+  echo $! > "$WORKSPACE_DIR/logs/xvfb.pid"
+  # X socket existence is a deterministic readiness boundary; gzserver must never race it.
+  display_number="${DISPLAY_VALUE#:}"
+  for _ in $(seq 1 50); do
+    [ -S "/tmp/.X11-unix/X${display_number}" ] && break
+    sleep 0.1
+  done
+  if [ ! -S "/tmp/.X11-unix/X${display_number}" ]; then
+    echo "Xvfb did not create DISPLAY=${DISPLAY_VALUE}; see logs/xvfb.log." >&2
+    exit 1
+  fi
+fi
+
+export DISPLAY="$DISPLAY_VALUE"
+export LIBGL_ALWAYS_SOFTWARE=1
+# `gui=false` 禁用 gzclient；`headless=false` 保留 Gazebo 传感器渲染，由上面的 Xvfb 承担显示后端。
+export GUI=false
+export GAZEBO_HEADLESS=false
+export PAUSED=true
+export START_CONTROLLER=1
+export CONTROLLER_FOREGROUND=0
+export SIMENV_AUTO_RL=1
+export AUTO_UNPAUSE_AFTER_CONTROLLER=1
+
+echo "Official headless profile: DISPLAY=${DISPLAY}, PAUSED=${PAUSED}, SIMENV_AUTO_RL=${SIMENV_AUTO_RL}"
+exec "$WORKSPACE_DIR/auto.sh"
